PORT=5000
NODE_ENV=development

# postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Must match the origin the client actually runs on (protocol + host + port).
CLIENT_URL=http://localhost:3000

# GitHub OAuth is optional — email/password works without it. Register a
# GitHub OAuth App with callback URL:
#   http://localhost:5000/api/auth/callback/github   (local dev)
#   https://<your-api-domain>/api/auth/callback/github (production)
# GitHub allows only one callback URL per OAuth App, so local dev and
# production need two separate apps (two separate client id/secret pairs).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
